# ─────────────────────────────────────────────────────────────────
#  Gate Monitor — Environment Configuration
# ─────────────────────────────────────────────────────────────────
#  NEVER commit this file to version control.
#  Copy .env.example to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# RTSP camera URL (include credentials if required)
# Used by --mode attendance (legacy single-camera mode)
RTSP_URL=rtsp://CAMERA_IP/live/0/MAIN

# If your camera needs authentication, use this format instead:
# RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP/live/0/MAIN

# ── Multi-camera URLs (used by cameras.yaml) ─────────────────────
# These are referenced as ${VAR_NAME} in cameras.yaml
# Set your camera URLs here — passwords stay in .env, not cameras.yaml
#
# CCTV/DVR camera (run: python tools/probe_camera.py <ip> to find URL)
CAMERA_CCTV_GATE_URL=rtsp://CAMERA_IP/live/0/MAIN
# CAMERA_CCTV_GATE_HIRES_URL=rtsp://CAMERA_IP/live/0/MAIN
#
# Phone camera (Android IP Webcam / DroidCam)
# CAMERA_PHONE_URL=http://CAMERA_IP:8080/video
#
# Additional cameras (add to cameras.yaml too)
# CAMERA_EXTRA_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/stream1
