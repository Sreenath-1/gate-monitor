# ─────────────────────────────────────────────────────────────────
#  Gate Monitor — Environment Configuration
# ─────────────────────────────────────────────────────────────────
#  NEVER commit this file to version control.
#  Copy .env.example to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# RTSP camera URL (include credentials if required)
RTSP_URL=rtsp://CAMERA_IP/live/0/MAIN

# If your camera needs authentication, use this format instead:
# RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP/live/0/MAIN
